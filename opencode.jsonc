{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "lsp": true,
  "compaction": {
    "auto": true,
    "threshold": 0.85,
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-vibeguard",
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{file:~/.secrets/stitch-key}",
      },
    },
  },
  "provider": {
    "omniroute": {
      "name": "omni",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:19793/v1",
        "apiKey": "{file:~/.secrets/omniroute-key}",
        "cache": true,
      },
    },
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "omniroute/think",
      "prompt": "{file:~/.config/opencode/prompts/orchestrator.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow",
        "skill": "allow",
        "playwright_*": "deny",
      },
    },
    "planner": {
      "mode": "subagent",
      "model": "omniroute/think",
      "prompt": "{file:~/.config/opencode/prompts/planner.txt}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "playwright_*": "deny",
      },
    },
    "designer": {
      "mode": "subagent",
      "model": "omniroute/code",
      "prompt": "{file:~/.config/opencode/prompts/designer.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "playwright_*": "deny",
      },
    },
    "coder": {
      "mode": "subagent",
      "model": "omniroute/code",
      "prompt": "{file:~/.config/opencode/prompts/coder.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "lsp": "allow",
        "skill": "allow",
        "playwright_*": "deny",
      },
    },
    "qa": {
      "mode": "subagent",
      "model": "omniroute/code",
      "prompt": "{file:~/.config/opencode/prompts/qa.txt}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "lsp": "allow",
        "skill": "allow",
        "playwright_*": "allow",
      },
    },
  },
}
