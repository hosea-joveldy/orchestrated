{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "lsp": true,
  "compaction": {
    "auto": true,
    "threshold": 0.85,
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-vibeguard",
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{file:~/.secrets/stitch-key}",
      },
    },
  },
  "provider": {
    "omniroute": {
      "name": "omni",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:19793/v1",
        "apiKey": "{file:~/.secrets/omniroute-key}",
        "cache": true,
      },
    },
  },
  "agent": {
    // NOTE: skill permission strings below are UNVERIFIED against your actual
    // superpowers install's naming convention. Before trusting this file, run
    // `use skill tool to list skills` inside opencode and confirm whether
    // superpowers skills appear as e.g. "brainstorming", "superpowers-brainstorming",
    // or "superpowers/brainstorming" -- then fix the keys below to match exactly.
    // Getting this wrong will silently block an agent from its assigned skills.
    "orchestrator": {
      "mode": "primary",
      "model": "omniroute/think",
      "prompt": "{file:~/.config/opencode/prompts/orchestrator.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow",
        "skill": {
          "using-superpowers": "allow",
          "using-git-worktrees": "allow",
          "executing-plans": "allow",
          "finishing-a-development-branch": "allow",
          "*": "deny",
        },
        "playwright_*": "deny",
      },
    },
    "planner": {
      "mode": "subagent",
      "model": "omniroute/think",
      "prompt": "{file:~/.config/opencode/prompts/planner.txt}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "skill": {
          "using-superpowers": "allow",
          "brainstorming": "allow",
          "writing-plans": "allow",
          "*": "deny",
        },
        "playwright_*": "deny",
      },
    },
    "designer": {
      "mode": "subagent",
      "model": "omniroute/code",
      "prompt": "{file:~/.config/opencode/prompts/designer.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "playwright_*": "deny",
        "skill": {
          "using-superpowers": "allow",
          "frontend-design": "allow",
          "*": "deny",
        },
      },
    },
    "coder": {
      "mode": "subagent",
      "model": "omniroute/code",
      "prompt": "{file:~/.config/opencode/prompts/coder.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "lsp": "allow",
        "skill": {
          "using-superpowers": "allow",
          "test-driven-development": "allow",
          "systematic-debugging": "allow",
          "receiving-code-review": "allow",
          "*": "deny",
        },
        "playwright_*": "deny",
      },
    },
    "qa": {
      "mode": "subagent",
      "model": "omniroute/code",
      "prompt": "{file:~/.config/opencode/prompts/qa.txt}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny",
        "lsp": "allow",
        "skill": {
          "using-superpowers": "allow",
          "verification-before-completion": "allow",
          "*": "deny",
        },
        "playwright_*": "allow",
      },
    },
  },
}
